# OrgaWork local development environment template.
# Copy this file to .env.local and keep the real local file outside Git.
# Only non-sensitive development defaults are allowed in this tracked template.
# Infrastructure variables will be added by their owning stages after their exact contracts are approved.

NODE_ENV=development

# API
HOST=127.0.0.1
PORT=3001

# Worker
WORKER_NAME=orgawork-worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_RUN_ONCE=false

# Scheduler
SCHEDULER_NAME=orgawork-scheduler
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_RUN_ONCE=false

# PostgreSQL 16
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=orgawork
POSTGRES_USER=orgawork
# Define POSTGRES_PASSWORD only in .env.local. Never commit it.
