{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@workspace/configuration": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/queue": "workspace:*",
    "@workspace/storage": "workspace:*",
    "fastify": "5.10.0",
    "@workspace/observability": "workspace:*",
    "@fastify/cookie": "11.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/security": "workspace:*",
    "@workspace/authentication": "workspace:*",
    "@workspace/organization-context": "workspace:*",
    "@workspace/authorization": "workspace:*",
    "@workspace/organization-administration": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
