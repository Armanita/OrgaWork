{
  "name": "orgawork",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare:quality": "pnpm build:foundation:direct && pnpm build:domain:direct",
    "check": "pnpm format:check && pnpm prepare:quality && pnpm lint && pnpm typecheck && pnpm test",
    "build:apps": "turbo run build --filter=@workspace/web --filter=@workspace/api --filter=@workspace/worker --filter=@workspace/scheduler",
    "dev:apps": "turbo run dev --parallel --filter=@workspace/web --filter=@workspace/api --filter=@workspace/worker --filter=@workspace/scheduler",
    "start:apps": "pnpm build:apps && tsx tools/scripts/start-applications.ts",
    "smoke:apps": "pnpm build:apps && tsx tools/checks/coordinated-applications-smoke.ts",
    "infra:start": "tsx tools/scripts/local-infrastructure.ts start",
    "infra:stop": "tsx tools/scripts/local-infrastructure.ts stop",
    "infra:report": "tsx tools/scripts/local-infrastructure.ts report",
    "infra:persistence": "tsx tools/scripts/local-data-persistence.ts",
    "infra:cleanup": "tsx tools/scripts/local-infrastructure.ts cleanup",
    "contract:check": "tsx tools/checks/contract-drift.ts",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:coverage:ci": "vitest run --config vitest.ci.config.ts --coverage",
    "build:foundation:direct": "pnpm --filter @workspace/configuration build && pnpm --filter @workspace/contracts build && pnpm --filter @workspace/api-client build && pnpm --filter @workspace/observability build && pnpm --filter @workspace/database build && pnpm --filter @workspace/queue build && pnpm --filter @workspace/storage build",
    "build:apps:direct": "pnpm prepare:quality && pnpm --filter @workspace/api build && pnpm --filter @workspace/worker build && pnpm --filter @workspace/scheduler build && pnpm --filter @workspace/web build",
    "ci:contracts": "vitest run tools/checks/contract-drift.test.ts tools/checks/api-contract-compatibility.test.ts",
    "ci:migrations": "vitest run packages/database/src/migrations.test.ts packages/database/src/migration-history.test.ts packages/database/src/migration-integrity.test.ts packages/database/src/database-roles.test.ts packages/database/src/tenant-runtime.test.ts",
    "ci:architecture": "tsx tools/checks/architecture-policy.ts",
    "ci:security": "tsx tools/checks/repository-security.ts",
    "ci:report": "tsx tools/scripts/ci-report.ts",
    "ci:acceptance": "vitest run tools/checks/ci-contract.test.ts tools/checks/p1.8-acceptance.test.ts",
    "spike:p1.9": "tsx tools/spikes/p1.9-report.ts",
    "spike:p1.9:real": "tsx tools/spikes/p1.9-real-infrastructure.ts",
    "ci:p1.9": "vitest run tools/spikes/p1.9-models.test.ts tools/spikes/p1.9-report.test.ts tools/checks/p1.9-acceptance.test.ts",
    "accept:p1.10:audit": "tsx tools/acceptance/p1.10-foundation-audit.ts auto",
    "accept:p1.10:audit:pre": "tsx tools/acceptance/p1.10-foundation-audit.ts pre",
    "accept:p1.10:audit:closed": "tsx tools/acceptance/p1.10-foundation-audit.ts closed",
    "accept:p2.1:audit": "tsx tools/acceptance/p2.1-identity-organization-contract-audit.ts auto",
    "accept:p2.1:audit:pre": "tsx tools/acceptance/p2.1-identity-organization-contract-audit.ts pre",
    "accept:p2.1:audit:closed": "tsx tools/acceptance/p2.1-identity-organization-contract-audit.ts closed",
    "build:domain:direct": "pnpm --filter @workspace/identity build && pnpm --filter @workspace/organizations build && pnpm --filter @workspace/teams build",
    "accept:p2.2:audit": "tsx tools/acceptance/p2.2-domain-model-audit.ts auto",
    "accept:p2.2:audit:pre": "tsx tools/acceptance/p2.2-domain-model-audit.ts pre",
    "accept:p2.2:audit:closed": "tsx tools/acceptance/p2.2-domain-model-audit.ts closed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
