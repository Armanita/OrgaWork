{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "بررسی پایه فضای کاری",
  "extends": "./packages/typescript-config/node.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": [
    "tools/checks/**/*.ts",
    "*.config.ts",
    "tools/scripts/**/*.ts",
    "tools/spikes/**/*.ts",
    "tools/acceptance/**/*.ts",
    "tools/verification/**/*.ts"
  ],
